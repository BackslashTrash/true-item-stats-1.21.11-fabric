{
	"schemaVersion": 1,
	"id": "true-item-stats",
	"version": "${version}",
	"name": "True Item Stats",
	"description": "Mod that shows easily comparable tooltips for armour and weapons, hold ctrl over items for extra info.",
	"authors": [
		"BackslashTrash"
	],
	"contact": {
		"homepage": "N/A",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/true-item-stats/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.backslashtrash.TrueItemStats"
		],
		"client": [
			"net.backslashtrash.client.TrueItemStatsClient"
		]
	},
	"mixins": [
		"true-item-stats.mixins.json",
		{
			"config": "true-item-stats.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}